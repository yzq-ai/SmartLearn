# SmartLearn backend configuration. Copy to `.env` and fill in production values.
DATABASE_URL=sqlite+aiosqlite:///./smartlearn.db
# DATABASE_URL=mysql+aiomysql://smartlearn:smartlearn_dev@127.0.0.1:3306/smart_learn
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
REDIS_URL=
# REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=memory://
# CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_BACKEND_URL=cache+memory://
CELERY_ALWAYS_EAGER=true
EXAM_DURATION_MINUTES=60
AI_REQUESTS_PER_MINUTE=10
AI_DAILY_LIMIT=200
CORS_ORIGINS=*
# OBS 对象存储（S3 兼容；留空则本地回退）
OBS_AK=
OBS_SK=
OBS_BUCKET=
OBS_ENDPOINT=
# 向量库（memory / qdrant / milvus）
VECTOR_BACKEND=memory
QDRANT_URL=
QDRANT_COLLECTION=smartlearn_kb
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=bge-large-zh
# 推送（log 占位 / agc）
PUSH_BACKEND=log
AGC_CLIENT_ID=
AGC_CLIENT_SECRET=
AGC_TOKEN_URL=https://oauth-login.cloud.huawei.com/oauth2/v3/token
AGC_PUSH_URL=https://push-api.cloud.huawei.com/v1/{app_id}/messages:send
AGC_APP_ID=
# 大模型（OpenAI 兼容协议；DeepSeek / GLM / Qwen 可一键切换）
# DeepSeek 配置示例（用户计划接入 DeepSeek）：
#   LLM_API_KEY=sk-你的deepseek密钥
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# 本地文件存储目录（未配置 OBS 时资源真实落盘位置）
LOCAL_STORAGE_DIR=./storage
